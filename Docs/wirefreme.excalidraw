    {
      "id": "2G6OmbkU5xx2Iov7Z2h3C",
      "type": "text",
      "x": 448.81498031877413,
      "y": -745.013085090187,
      "width": 123.11699705701567,
      "height": 10.051849881051584,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
